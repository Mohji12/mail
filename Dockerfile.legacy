# For: docker build with DOCKER_BUILDKIT=0 (build-lambda-legacy.ps1).
# Use ONLY on an x86_64 machine so the image matches Lambda "x86_64".
# (Classic builder does not handle FROM --platform well.)
FROM public.ecr.aws/lambda/python:3.11

WORKDIR /var/task

COPY requirements.txt .
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN pip install --upgrade pip wheel setuptools \
    && pip install --no-cache-dir --only-binary=:all: -r requirements.txt -t .

COPY app/ ./app

CMD ["app.main.handler"]
