# Optional: comma-separated extra frontend URLs (Amplify, custom domains)
# CORS_ORIGINS=https://your-app.amplifyapp.com,https://yourdomain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ZeptoMail (SMTP — api key in SMTP_PASSWORD is also used by the REST mailer)
SMTP_SERVER=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USERNAME=emailapikey
SMTP_PASSWORD=your_zeptomail_api_key
SENDER_EMAIL=support@harishcriticalcareclasses.com
SENDER_NAME=Harish Critical Care Classes

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=your_password
DB_NAME=harish
