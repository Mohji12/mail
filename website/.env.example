# Local backend (use this while developing; requires uvicorn on port 8001)
VITE_API_BASE_URL=http://127.0.0.1:8001

# Production backend — Cloudinary vars must be set on the SERVER (not in this file):
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET in app/.env or host env
# VITE_API_BASE_URL=https://diazstudios.site
# AWS Lambda (uncomment to use)
# VITE_API_BASE_URL=https://hl6mtpzm3jret5hcekgt3lqx2y0smqnc.lambda-url.ap-south-1.on.aws
